<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_UnifiedRetouchArchitecture"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.5.0">

  <bpmn:error id="Error_ZeroPhotos" name="Error_ZeroPhotos" errorCode="ERR_ZERO_PHOTOS" />
  <bpmn:dataStore id="DataStore_GCS_WAL_KG" name="GCS Bucket, SQLite WAL &amp; Knowledge Graph" />

  <bpmn:collaboration id="Collaboration_Studio">
    <bpmn:participant id="Participant_Studio" name="Aura Studio AI — Autonomous Jewelry Retouch &amp; Shopify Publishing Architecture" processRef="Process_StudioLifecycle" />
  </bpmn:collaboration>

  <bpmn:process id="Process_StudioLifecycle" name="Aura Studio AI End-to-End Retouch &amp; Storefront Lifecycle" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Studio">
      <bpmn:lane id="Lane_Shopify" name="Shopify Cloud &amp; Storefront CDN">
        <bpmn:flowNodeRef>StartEvent_DraftCreated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IngestMedia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LiveImageSwap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PromoteActive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_StorefrontLive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FastAPI" name="FastAPI Server, Webhook Gateway &amp; Async Orchestrator">
        <bpmn:flowNodeRef>Task_VerifyWebhook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidMedia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InvalidPurge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SafeDraftRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsNewDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StageHistorical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelPublish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstantHttp200</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BackgroundFinalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AsyncSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PurgeVariations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VariationsPurged</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operator" name="Studio Operator Review Workbench (UI)">
        <bpmn:flowNodeRef>Gateway_MergeToCatalog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CatalogQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CatalogAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DraftDismissed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewWorkbench</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PassQA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectVariation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickPublish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoAdvance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_QueueAdvanced</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AIEngine" name="Multi-Stage Anti-Hallucination AI Engine &amp; 3-Tier Escalation">
        <bpmn:flowNodeRef>Task_GemstoneMask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SpectralPolish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoCenter4K</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StageGCSWal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BroadcastSSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EscalationTier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tier1Reroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tier2Category</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tier3VisionScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AlloyAndLearn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteEscalated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:dataStoreReference id="DataStore_StudioVault" name="GCS Bucket, SQLite WAL
&amp; Knowledge Graph" dataStoreRef="DataStore_GCS_WAL_KG" />

    <bpmn:startEvent id="StartEvent_DraftCreated" name="Product Draft
Created on Shopify">
      <bpmn:outgoing>Flow_Start_Ingest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_IngestMedia" name="Ingest Raw Media
&amp; Product URLs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shopify-ingest-media" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Ingest_Verify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LiveImageSwap" name="1-to-1 In-Place
Shopify CDN Swap">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shopify-1to1-image-swap" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split_ToShopifySwap</bpmn:incoming>
      <bpmn:outgoing>Flow_Swap_ToPromote</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PromoteActive" name="Promote Draft to
Active on Store">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shopify-promote-active" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Swap_ToPromote</bpmn:incoming>
      <bpmn:outgoing>Flow_Promote_ToLiveEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_StorefrontLive" name="Product Live
on Storefront">
      <bpmn:incoming>Flow_Promote_ToLiveEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Task_VerifyWebhook" name="Verify HMAC
&amp; SSRF Guard">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-hmac-ssrf" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_ValidGate</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_ValidMedia" name="&gt;= 1 Valid Photos?" default="Flow_ValidMedia_Yes">
      <bpmn:incoming>Flow_Verify_ValidGate</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidMedia_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidMedia_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_InvalidPurge" name="0-Image / Orphan
Asset Purged">
      <bpmn:incoming>Flow_ValidMedia_No</bpmn:incoming>
      <bpmn:errorEventDefinition id="EndEvent_InvalidPurge_errDef" errorRef="Error_ZeroPhotos" />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_SafeDraftRule" name="Safe Draft Rule:
New vs Historical">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="evaluate-safe-draft-rule" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidMedia_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_SafeRule_Gate</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_IsNewDraft" name="New Store Draft?" default="Flow_NewDraft_Yes">
      <bpmn:incoming>Flow_SafeRule_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_NewDraft_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_NewDraft_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_StageHistorical" name="Stage Raw Draft
(0 Compute Spent)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="stage-historical-draft" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NewDraft_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Historical_ToCatalog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_ParallelPublish">
      <bpmn:incoming>Flow_Publish_ToParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_Parallel_ToHttp200</bpmn:outgoing>
      <bpmn:outgoing>Flow_Parallel_ToBgTask</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_InstantHttp200" name="Return HTTP 200
(&lt;200ms) + SSE">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-instant-http200-sse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Parallel_ToHttp200</bpmn:incoming>
      <bpmn:outgoing>Flow_Http200_ToAdvance</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_BackgroundFinalize" name="Async Background
Shopify Finalize">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="background-finalize-live" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Parallel_ToBgTask</bpmn:incoming>
      <bpmn:outgoing>Flow_BgTask_ToSplit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_AsyncSplit">
      <bpmn:incoming>Flow_BgTask_ToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_ToPurge</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_ToShopifySwap</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_PurgeVariations" name="Purge Unselected
GCS Variations">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="purge-unselected-variations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split_ToPurge</bpmn:incoming>
      <bpmn:outgoing>Flow_Purge_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_VariationsPurged" name="Temp Variations
Purged">
      <bpmn:incoming>Flow_Purge_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_GemstoneMask" name="Gem No-Fly Mask
&amp; Alpha Cutout">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="subpixel-alpha-gem-mask" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NewDraft_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_CV_1_To_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SpectralPolish" name="LAB Spectral Lock
&amp; Metal Polish">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="spectral-lock-metal-polish" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CV_1_To_2</bpmn:incoming>
      <bpmn:outgoing>Flow_CV_2_To_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_AutoCenter4K" name="BBox Auto-Center
&amp; 4K WebP Master">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bbox-autocenter-4k-webp" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CV_2_To_3</bpmn:incoming>
      <bpmn:outgoing>Flow_CV_3_To_4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_StageGCSWal" name="Stage 4K Master
to GCS &amp; SQLite">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="stage-gcs-sqlite-wal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CV_3_To_4</bpmn:incoming>
      <bpmn:outgoing>Flow_CV_4_To_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_BroadcastSSE" name="Push Live SSE
Event to Studio">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="broadcast-sse-retouch" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CV_4_To_5</bpmn:incoming>
      <bpmn:outgoing>Flow_SSE_ToCatalog</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_MergeToCatalog">
      <bpmn:incoming>Flow_Historical_ToCatalog</bpmn:incoming>
      <bpmn:incoming>Flow_SSE_ToCatalog</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_ToCatalog</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CatalogQueue" name="Dual-Tile Queue
(Raw vs Master)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Merge_ToCatalog</bpmn:incoming>
      <bpmn:outgoing>Flow_Catalog_ToGate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CatalogAction" name="Card Action?" default="Flow_Catalog_Review">
      <bpmn:incoming>Flow_Catalog_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Catalog_Dismiss</bpmn:outgoing>
      <bpmn:outgoing>Flow_Catalog_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_DraftDismissed" name="Hidden from Queue
(Safe on Shopify)">
      <bpmn:incoming>Flow_Catalog_Dismiss</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ReviewWorkbench" name="Symmetrical Bench
Multi-Angle QA">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Catalog_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Bench_ToQAGate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PassQA" name="Baseline Passes QA?" default="Flow_QA_Pass">
      <bpmn:incoming>Flow_Bench_ToQAGate</bpmn:incoming>
      <bpmn:outgoing>Flow_QA_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_QA_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_EscalationTier" name="Escalation Tier?" default="Flow_Tier2_Category">
      <bpmn:incoming>Flow_QA_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Tier1_Reroll</bpmn:outgoing>
      <bpmn:outgoing>Flow_Tier2_Category</bpmn:outgoing>
      <bpmn:outgoing>Flow_Tier3_Vision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Tier1Reroll" name="Tier 1 RE-ROLL:
Fresh Seed Pass">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reroll-fresh-seed" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Tier1_Reroll</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Tier1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Tier2Category" name="Tier 2 Category:
Matrix Rules">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apply-category-optical-formula" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Tier2_Category</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Tier2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_Tier3VisionScan" name="Tier 3 AI Vision
&amp; KG Ground Lock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gemini-vision-kg-lock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Tier3_Vision</bpmn:incoming>
      <bpmn:outgoing>Flow_Vision_ToAlloy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AlloyAndLearn" name="Alloy Switcher &amp;
Save Category">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Vision_ToAlloy</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Tier3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeEscalation">
      <bpmn:incoming>Flow_Join_Tier1</bpmn:incoming>
      <bpmn:incoming>Flow_Join_Tier2</bpmn:incoming>
      <bpmn:incoming>Flow_Join_Tier3</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalated_ToRender</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ExecuteEscalated" name="Render Variation
to Studio Tray">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="execute-grounded-retouch" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Escalated_ToRender</bpmn:incoming>
      <bpmn:outgoing>Flow_Render_ToSelect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SelectVariation" name="Select Candidate
in Tray">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Render_ToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_ToApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_JoinApproved">
      <bpmn:incoming>Flow_QA_Pass</bpmn:incoming>
      <bpmn:incoming>Flow_Select_ToApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_ToPublish</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ClickPublish" name="Click PUBLISH
(Confirm Master)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved_ToPublish</bpmn:incoming>
      <bpmn:outgoing>Flow_Publish_ToParallel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AutoAdvance" name="Auto-Advance UI
Queue (&lt;0.5s)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Http200_ToAdvance</bpmn:incoming>
      <bpmn:outgoing>Flow_Advance_ToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_QueueAdvanced" name="Workbench Ready
for Next SKU">
      <bpmn:incoming>Flow_Advance_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Ingest" sourceRef="StartEvent_DraftCreated" targetRef="Task_IngestMedia" />
    <bpmn:sequenceFlow id="Flow_Ingest_Verify" sourceRef="Task_IngestMedia" targetRef="Task_VerifyWebhook" />
    <bpmn:sequenceFlow id="Flow_Verify_ValidGate" sourceRef="Task_VerifyWebhook" targetRef="Gateway_ValidMedia" />
    <bpmn:sequenceFlow id="Flow_ValidMedia_No" name="0 Photos" sourceRef="Gateway_ValidMedia" targetRef="EndEvent_InvalidPurge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=photosCount = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ValidMedia_Yes" name="Valid" sourceRef="Gateway_ValidMedia" targetRef="Task_SafeDraftRule" />
    <bpmn:sequenceFlow id="Flow_SafeRule_Gate" sourceRef="Task_SafeDraftRule" targetRef="Gateway_IsNewDraft" />
    <bpmn:sequenceFlow id="Flow_NewDraft_No" name="Historical" sourceRef="Gateway_IsNewDraft" targetRef="Task_StageHistorical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isHistoricalDraft = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NewDraft_Yes" name="New Draft (Auto)" sourceRef="Gateway_IsNewDraft" targetRef="Task_GemstoneMask" />
    <bpmn:sequenceFlow id="Flow_Historical_ToCatalog" sourceRef="Task_StageHistorical" targetRef="Gateway_MergeToCatalog" />
    <bpmn:sequenceFlow id="Flow_CV_1_To_2" sourceRef="Task_GemstoneMask" targetRef="Task_SpectralPolish" />
    <bpmn:sequenceFlow id="Flow_CV_2_To_3" sourceRef="Task_SpectralPolish" targetRef="Task_AutoCenter4K" />
    <bpmn:sequenceFlow id="Flow_CV_3_To_4" sourceRef="Task_AutoCenter4K" targetRef="Task_StageGCSWal" />
    <bpmn:sequenceFlow id="Flow_CV_4_To_5" sourceRef="Task_StageGCSWal" targetRef="Task_BroadcastSSE" />
    <bpmn:sequenceFlow id="Flow_SSE_ToCatalog" sourceRef="Task_BroadcastSSE" targetRef="Gateway_MergeToCatalog" />
    <bpmn:sequenceFlow id="Flow_Merge_ToCatalog" sourceRef="Gateway_MergeToCatalog" targetRef="Task_CatalogQueue" />
    <bpmn:sequenceFlow id="Flow_Catalog_ToGate" sourceRef="Task_CatalogQueue" targetRef="Gateway_CatalogAction" />
    <bpmn:sequenceFlow id="Flow_Catalog_Dismiss" name="Dismiss" sourceRef="Gateway_CatalogAction" targetRef="EndEvent_DraftDismissed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=action = "dismiss"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Catalog_Review" name="Review" sourceRef="Gateway_CatalogAction" targetRef="Task_ReviewWorkbench" />
    <bpmn:sequenceFlow id="Flow_Bench_ToQAGate" sourceRef="Task_ReviewWorkbench" targetRef="Gateway_PassQA" />
    <bpmn:sequenceFlow id="Flow_QA_Pass" name="Yes (~80% Pass)" sourceRef="Gateway_PassQA" targetRef="Gateway_JoinApproved" />
    <bpmn:sequenceFlow id="Flow_QA_Escalate" name="No (Escalate)" sourceRef="Gateway_PassQA" targetRef="Gateway_EscalationTier">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=passesQA = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Tier1_Reroll" name="RE-ROLL" sourceRef="Gateway_EscalationTier" targetRef="Task_Tier1Reroll">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=escalationTier = "reroll"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Tier2_Category" name="Category" sourceRef="Gateway_EscalationTier" targetRef="Task_Tier2Category" />
